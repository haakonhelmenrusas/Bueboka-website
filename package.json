		"motion": "^14.6.0",
		"next": "^16.4.3",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.6.0",
		"react-is": "^19.3.1",
